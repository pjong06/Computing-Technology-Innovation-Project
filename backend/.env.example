SUPABASE_URL=https://yzhxjzbzslnveskkwvfy.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Existing SUPABASE_KEY configurations are also accepted.

# Sprint 1 activity 5.3: backend MQTT subscriber.
# EMQX Serverless requires mqtts:// and port 8883.
MQTT_URL=mqtts://your-emqx-host:8883
MQTT_TOPIC_FILTER=niah/telemetry/+
MQTT_USERNAME=
MQTT_PASSWORD=
# Development only. Never set true in production.
MQTT_ALLOW_INSECURE_TLS=false

# Sprint 1 activity 5.4 prototype threat thresholds.
# Replace these values after the physical sensors are calibrated.
IOT_HIGH_TEMPERATURE_C=35
IOT_LOW_SOIL_MOISTURE_PCT=20
IOT_PROXIMITY_CM=50
IOT_HEAVY_RAIN_PCT=70

# Enable only after the recovery client and Supabase email template are configured.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RESET_REDIRECT_URL=https://your-approved-domain.example/recovery
