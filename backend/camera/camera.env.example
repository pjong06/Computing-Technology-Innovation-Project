# Copy to backend/camera.local.env (ignored). No values here are credentials.
CAMERA_BACKEND_PORT=3002
CAMERA_MQTT_TOPIC_FILTER=niah/camera-test/demo
CAMERA_DEVICE_INDEX=0
CAMERA_COOLDOWN_MS=30000
# Prototype proximity threshold; agree with Shan Kai before field acceptance.
CAMERA_DISTANCE_CM=100
CAMERA_STORAGE_ENABLED=false
# Optional absolute path; default is backend/.camera-runtime/Scripts/python.exe.
CAMERA_PYTHON=
# Cloud upload requires owner-reviewed schema/bucket and server credentials.
CAMERA_DATABASE_SERVER_KEY=
# MQTT_URL, MQTT_USERNAME, MQTT_PASSWORD and existing Supabase/auth settings
# are read from local backend configuration, never committed here.
